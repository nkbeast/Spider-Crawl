# ── Spider Crawl API keys ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in what you have. `.env` is gitignored.
# ALL keys are optional — the tool runs fine with none of them.
# Only the `github` source requires GITHUB_TOKEN to return results.
#
#   cp .env.example .env && $EDITOR .env
#

# VirusTotal — https://www.virustotal.com → profile → API key
VIRUSTOTAL_API_KEY=

# URLScan.io — https://urlscan.io → user settings → API key
URLSCAN_API_KEY=

# Shodan — https://account.shodan.io
SHODAN_API_KEY=

# GitHub PAT (classic, read-only is enough) — https://github.com/settings/tokens
# Needed only for the `github` code-dorking source (10 req/min limit).
GITHUB_TOKEN=
